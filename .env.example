# Frontier Model API Selection Toggles ("anthropic" or "openai")
RSI_LLM_PROVIDER=anthropic

# Frontier Model API Keys (DO NOT put your real keys in this file)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# RSI Operational Settings
AGENT_ENV=development
MAX_MUTATION_GENERATIONS=10
