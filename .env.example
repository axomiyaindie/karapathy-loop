# Provider selection and model identifiers
RSI_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=your-supported-anthropic-model-id
OPENAI_API_KEY=replace_me
OPENAI_MODEL=your-supported-openai-model-id

# Loop and evaluation controls
AGENT_GEN=1
RSI_MAX_CYCLES=3
RSI_TOKEN_LIMIT=3500
RSI_REQUEST_TOKEN_LIMIT=16000
RSI_EVALUATION_TIMEOUT=120
RSI_SANDBOX_IMAGE=python:3.12-slim

# Promotion is disabled by default. Push requires both flags enabled.
RSI_AUTO_COMMIT=false
RSI_AUTO_PUSH=false
